NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: the API version in src/sanity/env.ts applies when unset.
# NEXT_PUBLIC_SANITY_API_VERSION=

# Sanity Viewer token (server only): draft mode and the Presentation tool
# (/api/draft-mode/enable) read drafts with it. Never a write token.
SANITY_API_READ_TOKEN=
# Write token for the content scripts only (scripts/sanity/*), an Editor
# token of its own; the app never reads it.
# SANITY_TOKEN=
# Secret set on the Sanity webhook that calls /api/revalidate.
SANITY_WEBHOOK_SECRET=

# Canonical site URL used for sitemap, robots, OG tags, canonical links.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://alirezamp.com

# Spotify now-playing widget (/api/spotify/now-playing). Mint the refresh
# token with `bun scripts/spotify-refresh-token.mjs`; the app must have
# http://127.0.0.1:8888/callback as a redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
